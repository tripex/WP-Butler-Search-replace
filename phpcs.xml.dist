<?xml version="1.0"?>
<ruleset name="Smart Search Replace">
	<description>WordPress coding standards focused on correctness, security and i18n for a modern OOP plugin.</description>

	<file>./smart-search-replace.php</file>
	<file>./uninstall.php</file>
	<file>./src</file>
	<file>./views</file>

	<arg name="extensions" value="php" />
	<arg name="colors" />
	<arg value="ps" />

	<config name="testVersion" value="8.1-" />
	<config name="minimum_wp_version" value="6.4" />

	<!-- Security: every input/output/DB rule the wordpress.org reviewers care about. -->
	<rule ref="WordPress.Security" />
	<rule ref="WordPress.DB" />
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="smart-search-replace" />
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.EnqueuedResources" />
	<rule ref="WordPress.WP.GlobalVariablesOverride" />
	<rule ref="WordPress.WP.AlternativeFunctions" />
	<rule ref="WordPress.WP.DeprecatedFunctions" />
	<rule ref="WordPress.WP.DeprecatedClasses" />
	<rule ref="WordPress.WP.DeprecatedParameters" />
	<rule ref="WordPress.WP.DeprecatedParameterValues" />
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<!-- Serialized-data handling is a core feature of this plugin. -->
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.serialize_serialize" />
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.serialize_unserialize" />
	</rule>
	<rule ref="WordPress.PHP.NoSilencedErrors">
		<!-- We use @ exclusively around preg_* / unserialize where we read preg_last_error()
		     or check return values explicitly. -->
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.PHP.DontExtract" />

	<!-- Compatibility checks for declared PHP/WP versions. -->
	<rule ref="PHPCompatibilityWP" />
</ruleset>
